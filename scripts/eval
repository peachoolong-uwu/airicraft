#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command="${1:-run}"
if [[ $# -gt 0 ]]; then
	shift
fi

usage() {
	cat <<'USAGE'
usage: scripts/eval run [gradle args...]

run launches the HotSwap evaluator with no optional integrations by default.
Set AIRICRAFT_EVALUATOR_SCENARIO_MANIFEST to a scenario.yml path to load its requiredMods.
You can also pass -Pairicraft.evaluator.scenarioManifest=/absolute/path/scenario.yml.
Run ./gradlew hotswapMain --continuous in a second terminal to reload main-mod classes.
Evaluator-addon and compatibility-addon changes still need a client restart.
USAGE
}

case "$command" in
	run)
		cd "$repo_root"
		if [[ -f .envrc ]]; then
			# shellcheck disable=SC1091
			source .envrc
		fi
		game_dir="${AIRICRAFT_EVALUATOR_GAME_DIR:-$repo_root/run}"
		if [[ "$game_dir" != /* ]]; then
			printf 'AIRICRAFT_EVALUATOR_GAME_DIR must be an absolute path\n' >&2
			exit 2
		fi
		gradle_args=(
			"-Pairicraft.evaluator.runDir=$game_dir"
			"-Pairicraft.evaluator.jdwp.enabled=${AIRICRAFT_EVALUATOR_JDWP_ENABLED:-true}"
			"-Pairicraft.evaluator.runtimePrepared=${AIRICRAFT_EVALUATOR_RUNTIME_PREPARED:-false}"
		)
		if [[ -n "${AIRICRAFT_EVALUATOR_PLAYER_NAME:-}" ]]; then
			gradle_args+=("-Pairicraft.devPlayerName=$AIRICRAFT_EVALUATOR_PLAYER_NAME")
		fi
		if [[ -n "${AIRICRAFT_RECORDER_JAR:-}" ]]; then
			gradle_args+=("-Pairicraft.evaluator.recorderJar=$AIRICRAFT_RECORDER_JAR")
		fi
		exec ./gradlew "${gradle_args[@]}" -Pairicraft.includeEvaluator=true -Pairicraft.includeCompat=true :runClientEvaluator "$@"
		;;
	-h | --help | help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
esac
